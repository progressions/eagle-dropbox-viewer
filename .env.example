# Single-user app gate
APP_USERNAME=isaac
APP_PASSWORD=change-me

# Dropbox app (https://www.dropbox.com/developers/apps)
# Permissions: files.metadata.read, files.content.read, account_info.read
# Redirect URI must match exactly:
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:4010/auth/dropbox/callback

# Eagle library root inside Dropbox
DROPBOX_LIBRARY_PATH=/ISAAC/GENNIE/Eunbi.library

# Phoenix (PromptForge owns 4000 on Ginger)
PORT=4010
# SECRET_KEY_BASE=  # required in prod; mix phx.gen.secret
# DATABASE_URL=     # required in prod
