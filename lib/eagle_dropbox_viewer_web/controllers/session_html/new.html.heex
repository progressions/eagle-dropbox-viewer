<Layouts.flash_group flash={@flash} />
<div class="mx-auto max-w-md px-4 py-16">
  <h1 class="text-2xl font-semibold tracking-tight">Eagle Dropbox Viewer</h1>
  <p class="mt-2 text-sm text-base-content/70">
    Single-user sign-in. Dropbox connect stays behind this gate.
  </p>

  <.form for={%{}} as={:session} action={~p"/login"} method="post" class="mt-8 space-y-4">
    <div>
      <label class="label" for="session_username"><span class="label-text">Username</span></label>
      <input
        id="session_username"
        name="session[username]"
        type="text"
        autocomplete="username"
        required
        class="input input-bordered w-full"
      />
    </div>
    <div>
      <label class="label" for="session_password"><span class="label-text">Password</span></label>
      <input
        id="session_password"
        name="session[password]"
        type="password"
        autocomplete="current-password"
        required
        class="input input-bordered w-full"
      />
    </div>
    <button type="submit" class="btn btn-primary w-full">Sign in</button>
  </.form>
</div>
